#!/usr/bin/env bash
# fbmail — Shiraz-League file-mailbox CLI (Mailbox v2)
#
# One portable bash tool that both the Lead (host) and workers (podman containers)
# run. No jq/python/node dependency: only bash + coreutils, because the worker
# containers are minimal.
#
#   fbmail board              regenerate BOARD.md from INBOX + OUTBOX
#   fbmail status [--json]    tasks, stale claims, missing reports, open nags
#   fbmail claim <id> <inst>  set Status: claimed by <inst>
#   fbmail check <id>         is the brief's report present + END-terminated?
#   fbmail done <id>          set Status: done (Lead only)
#   fbmail nag                list open nags
#   fbmail nag-done <file> <answer>
#   fbmail lock <path>... [-b TASK-XXX]
#                             record "I hold this path" BEFORE writing it
#   fbmail unlock <path>...|--all|--expired
#                             release; --expired clears STALE locks only
#                             advisory + always expirable: a lock older than
#                             FBMAIL_LOCK_TTL (default 120m) is STALE, the next
#                             `lock` takes it over, and --expired clears it; a
#                             LIVE lock is never broken (NAG/BUS the Lead)
#   fbmail send <inst> <text> drop a note into BUS/ (and .fb-mailbox compat)
#   fbmail health             show worker HEALTH/*.json summaries
#   fbmail doctor [--fix]     instance environment health; --fix applies repairs
#   fbmail watch [--interval N] [--once]
#                             poll INBOX: auto-claim own briefs, raise ALERTs for
#                             stale claims / missing reports
#
# Exit codes:
#   0  ok
#   1  usage / not-found / cannot locate the project root
#   2  attention needed (status), or a guard refused: a `lock`/`unlock` blocked by
#      a live lock, or `done` refusing to close a brief another instance holds
#   3  `check` only: the brief is malformed (no readable Status) — see the `check`
#      table below, which is a contract, not a hint
#
# `check` exit codes (one outcome per code — a gate must tell "not finished yet"
# from "finished but corrupt" from "brief is broken"):
#   0  report present and TASK-<id>-END is its last non-empty line
#   1  no report yet — the task is simply not finished (not an error)
#   2  report present but the END marker is missing or not the last non-empty line
#   3  brief is malformed (no readable Status)
#
# Project root: $FBMAIL_ROOT honoured-or-refused when set; otherwise auto-detected
# from $PWD, then from this script's own location, then through the known container
# mount layouts — so the tool works identically on the host and inside a container,
# for any project in the tree (not just the one it was authored in).

set -u

VERSION="2.1.1"

# ---------------------------------------------------------------- root finding

find_root() {
    local d

    # (1) An explicit FBMAIL_ROOT is a caller's contract: honour it, or REFUSE.
    # Falling through to the mount layouts below is what made audit F5 dangerous —
    # `FBMAIL_ROOT=/typo claim 011 fb2` found nothing during the ascent, then
    # matched the hard-coded REAL host path, so it mutated the live mailbox while
    # the caller believed it was in a scratch tree. The selftest harness and any
    # throwaway-tree run depend on this being honoured.
    if [ -n "${FBMAIL_ROOT:-}" ]; then
        if [ -d "$FBMAIL_ROOT/mailbox/INBOX" ]; then printf '%s\n' "$FBMAIL_ROOT"; return 0; fi
        echo "fbmail: FBMAIL_ROOT='${FBMAIL_ROOT}' is not a project root (no mailbox/INBOX in it);" >&2
        echo "        unset it or point it at the project." >&2
        return 1
    fi

    # (2) Ascend from $PWD — the normal case: you are somewhere inside the project.
    d="$PWD"
    while [ "$d" != "/" ] && [ -n "$d" ]; do
        if [ -d "$d/mailbox/INBOX" ]; then printf '%s\n' "$d"; return 0; fi
        d="$(dirname "$d")"
    done

    # (3) Self-location: this script lives at <root>/mailbox/bin/fbmail. This is
    # what makes a copy of the mailbox PORTABLE to another project — the tool finds
    # its own project instead of a hard-coded one (TASK-039).
    local self own
    self="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" 2>/dev/null && pwd -P)" || self=""
    if [ -n "$self" ]; then
        own="$(cd "$self/../.." 2>/dev/null && pwd -P)" || own=""
        if [ -n "$own" ] && [ -d "$own/mailbox/INBOX" ]; then printf '%s\n' "$own"; return 0; fi

        # (4) The same project seen through a container mount. Host
        # `personal/projects` is mounted as /workspace/personal-projects and
        # /work/current, so a project at <workspace>/projects/<name> is also at
        # <mount>/projects/<name>. Derived from (3), not hard-coded per project.
        local rel=""
        case "$own" in
            */personal/projects/*) rel="${own#*/personal/projects/}" ;;
        esac
        if [ -n "$rel" ]; then
            local c
            for c in \
                "${HOME:-/root}/work/current" \
                /work/current \
                /workspace/personal-projects \
                /mnt/home-shai/personal/projects \
                /home/shai/personal/projects
            do
                [ -d "$c/$rel/mailbox/INBOX" ] && { printf '%s\n' "$c/$rel"; return 0; }
            done
        fi
    fi
    return 1
}

ROOT="$(find_root)" || {
    echo "fbmail: cannot locate project root (set FBMAIL_ROOT=...)" >&2
    exit 1
}
MB="$ROOT/mailbox"
INBOX="$MB/INBOX"
OUTBOX="$MB/OUTBOX"
NAGS="$MB/NAGS"
BUS="$MB/BUS"
HEALTH="$MB/HEALTH"
ALERTS="$MB/ALERTS"
STATE="$MB/.state"

# PROJECT_NAME — the project's own name, for human-facing headers (`status`, `board`,
# the JSON "task" field, doctor). Derived from the resolved root so a COPY of this
# mailbox reports its own project instead of the one it was authored in (TASK-042;
# before this, a simorgh-platform copy printed "shiraz-league mailbox status").
PROJECT_NAME="$(basename "$ROOT")"

ensure_dirs() { mkdir -p "$INBOX" "$OUTBOX" "$NAGS" "$BUS" "$HEALTH" "$ALERTS" "$STATE" 2>/dev/null || true; }

# Advisory file locks (TASK-027). They live under $STATE because that directory is
# already gitignored for exactly this kind of transient truth — and because
# .gitignore is outside this task's allowlist, so a sibling mailbox/.locks/ could
# not have been ignored by a file this lane is allowed to edit.
LOCKDIR="$STATE/locks"
LOCK_TTL_MIN="${FBMAIL_LOCK_TTL:-120}"
TAB="$(printf '\t')"

now_iso() { date '+%Y-%m-%dT%H:%M'; }
now_epoch() { date '+%s'; }
ts() { date '+%F %T'; }

# sed_inplace <script> <file>
# GNU and BSD sed disagree on -i: GNU takes the backup suffix ATTACHED to the
# flag (sed -i.bak), BSD takes it as a separate argument (sed -i ''). Trying
# GNU first and falling back to BSD syntax is the bug this replaces: on GNU sed
# `sed -i '' "$script" "$file"` makes '' the script, so sed reads the *script*
# text as a filename and the edit never happens. Detect the flavour once.
sed_inplace() {
    if sed --version >/dev/null 2>&1; then
        sed -i "$1" "$2"        # GNU
    else
        sed -i '' "$1" "$2"     # BSD / macOS
    fi
}

# esc_repl — escape a string for use in a sed REPLACEMENT using the | delimiter.
esc_repl() { printf '%s' "$1" | sed 's/[&\\|]/\\&/g'; }

# status_line_script <new-status-text>
# A sed script that rewrites a "- Status:" line, preserving its leading indent
# and dash. Anchored on the literal field name and NEVER interpolating the old
# status value: real statuses look like `open — **highest priority for fb3.**`
# whose `**` is a BRE metacharacter, which is what made the previous claim fail.
# Built with `printf '%s'` on purpose — a printf FORMAT string would read \1 as
# an octal escape and destroy the backreference. BRE \(..\)/\1 groups work in
# both GNU and BSD sed, and no `0,/re/` address is used (GNU-only).
status_line_script() {
    local re='^\([[:space:]]*-\)[[:space:]]*Status:'
    printf '%s' "s|$re.*|\1 Status: $(esc_repl "$1")|"
}

# ---------------------------------------------------------------- brief parsing

# brief_field <file> <Status|Owner>
# Reads, in order:
#   1. the authoritative list form, `- Key: value` (the one claim/done write); then
#   2. the tolerated markdown-bold inline form, `**Key:** value · …` — read-only
#      support for briefs authored before the header contract existed.
# A key present in neither form yields "". Callers that must tell "absent" from
# "present but empty" ask brief_has_list_field instead.
brief_field() {
    local file="${1:-}" key="${2:-}" val
    [ -r "$file" ] || return 0
    val="$(sed -n "s/^[[:space:]]*-[[:space:]]*$key:[[:space:]]*//Ip" "$file" 2>/dev/null | head -1)"
    if [ -z "$val" ]; then
        # Bold inline form: the value runs to the next " · " field separator.
        val="$(sed -n "s/.*\*\*$key:\*\*[[:space:]]*//Ip" "$file" 2>/dev/null | head -1)"
        case "$val" in *" · "*) val="${val%% · *}" ;; esac
    fi
    val="${val%$'\r'}"
    # Trim surrounding whitespace, so a trailing space cannot defeat is_open etc.
    val="${val#"${val%%[![:space:]]*}"}"
    val="${val%"${val##*[![:space:]]}"}"
    printf '%s' "$val"
}

# brief_has_list_field <file> <Key> — is the authoritative "- Key:" line present?
# brief_field's empty result is ambiguous ("no field" vs "empty value"), and the
# write path must know which before deciding to rewrite or insert.
brief_has_list_field() {
    sed -n "s/^[[:space:]]*-[[:space:]]*$2:.*/x/p" "${1:-}" 2>/dev/null | head -1 | grep -q x
}

# brief_is_malformed <file> — a brief whose Status cannot be read from either
# header shape. Such a brief can be neither claimed nor watched, so nothing may
# report it as ok (TASK-034: it used to read as a silent, healthy `ok`).
brief_is_malformed() {
    [ -z "$(brief_field "${1:-}" Status)" ]
}

# insert_status_line <file> <text> — append "- Status: <text>" after the title
# line. POSIX sed `a` (the two-line form GNU and BSD both accept), used only when
# a tolerated bold-header brief has no authoritative "- Status:" line to rewrite.
insert_status_line() {
    sed_inplace "$(printf '1a\\\n- Status: %s\n' "${2:-}")" "${1:-}"
}

# set_brief_status <file> <text> — the one write path claim/done share: rewrite
# the "- Status:" line when present, insert it when absent. The list form stays
# authoritative; the bold form is only ever read, never rewritten.
set_brief_status() {
    local file="${1:-}" text="${2:-}"
    if brief_has_list_field "$file" Status; then
        sed_inplace "$(status_line_script "$text")" "$file"
    else
        insert_status_line "$file" "$text"
    fi
}

brief_id() { basename "$1" | sed -n 's/^TASK-\([0-9][0-9]*\).*/\1/p'; }

# owner from the "- Status:" / "- Owner:" line, normalised to fb2|fb3|any|lead|other
norm_owner() {
    local v; v="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
    case "$v" in
        *fb2*) echo fb2 ;;
        *fb3*) echo fb3 ;;
        *any*) echo any ;;
        *lead*|*buffy*) echo lead ;;
        "") echo "" ;;
        *) echo other ;;
    esac
}

# claimer from a "claimed by fb2 ..." status string
# The instance a `claimed by <inst> <time>` status names.
#
# This is the read half of the identity story and it must mirror canon_inst,
# the write half. canon_inst has always accepted any identity (a Lead lane, a
# `pool` agent); this function only knew fb2/fb3, so `fbmail claim 037 lead`
# wrote `- Status: claimed by lead …` and then reported **"claim lost to "**
# (exit 2) on the very line that verifies its own write — a successful claim
# reported as a lost race. The same blindness left the "Claimed by" column
# empty for every non-fleet identity and made a Lead lane unable to age into
# 🔴stale, because staleness is gated on a non-empty instance.
claim_inst() {
    local v rest inst
    v="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
    rest="${v#*claimed by }"
    [ "$rest" = "$v" ] && { echo ""; return; }   # not a claim line
    # Word-split the remainder so the first token is the instance.
    # shellcheck disable=SC2086
    set -- $rest
    inst="${1:-}"
    [ -n "$inst" ] || { echo ""; return; }
    canon_inst "$inst"
}

# ---------------------------------------------------------------- locks
#
# An advisory write-lock, so two instances stop editing one tree blind (audit
# F8: server.go briefly held two RegisterFixtureImportRoutes calls written ~1s
# apart, and a duplicate mux.Handle panics ServeMux inside Handler() where
# neither `go build` nor `go vet` can see it).
#
# Shape: ONE FILE PER (path, holder) in $LOCKDIR. Nothing is ever rewritten in
# place — a lock is created by writing a temp file and renaming it, and released
# by unlinking it — so two instances cannot corrupt each other's lock the way a
# shared ledger file would. Ownership is matched on the recorded `path:` FIELD,
# never on the filename: safe_name() is an encoding, not a hash, and
# prefix-matching filenames would confuse `internal/x` with `internal/x/y`.
#
# Locks are ADVISORY and always expirable. A lock at or past $LOCK_TTL_MIN
# ($FBMAIL_LOCK_TTL, default 120 minutes) is STALE: `fbmail lock` takes it over
# with a loud warning and `fbmail unlock --expired` clears it, so no abandoned
# lock can ever wedge the fleet. A LIVE lock is never broken by a worker — that
# is a NAG or a BUS note to the Lead.

# canon_inst — one identity per instance. The fleet currently spells itself three
# ways: FB_INSTANCE and HEALTH/ use `freebuff3`, brief Owner lines and
# claim_inst use `fb3`, and watch uses "${FB_INSTANCE#freebuff}". TASK-021
# already had to reconcile a claim marker split by exactly that alias
# (.state/claimed-fb3 vs .state/claimed-freebuff3). Every lock key goes through
# this so a holder is one key, never three.
canon_inst() {
    local v; v="$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')"
    case "$v" in
        "") echo "" ;;
        *fb2*|*freebuff2*) echo fb2 ;;
        *fb3*|*freebuff3*) echo fb3 ;;
        *) printf '%s' "$v" ;;
    esac
}

# my_inst — the canonical id this instance locks and claims under.
my_inst() { canon_inst "${FB_INSTANCE:-$(hostname 2>/dev/null || echo host)}"; }

# send_from — the sender recorded on a BUS note. Only the two worker identities
# name themselves; every other identity keeps the historical "lead" label.
send_from() {
    case "$(my_inst)" in
        fb2|fb3) my_inst ;;
        *) printf '%s' "lead" ;;
    esac
}

# norm_path — one spelling per file, so the host (/mnt/home-shai/...) and a
# container (/work/current/...) lock the SAME path. An absolute path under the
# project root becomes repo-relative; empty, tab or newline is refused because it
# would break the lock file's line format.
norm_path() {
    local p="${1:-}"
    case "$p" in "$ROOT"/*) p="${p#"$ROOT"/}" ;; esac
    while :; do
        case "$p" in ./*) p="${p#./}" ;; *) break ;; esac
    done
    case "$p" in */) p="${p%/}" ;; esac
    case "$p" in ""|*$'\t'*|*$'\n'*) return 1 ;; esac
    printf '%s' "$p"
}

# safe_name — encode a path into one filename component. `%` is escaped FIRST so
# the encoding stays reversible: a path that literally contains `%2F` can never
# collide with a real `/`.
safe_name() { local p="${1//%/%25}"; printf '%s' "${p//\//%2F}"; }

# json_esc — the lock report is the one place a free-text path reaches JSON, and
# a path is not guaranteed to be quote-free. Escape `\` then `"`.
json_esc() { local s="${1//\\/\\\\}"; printf '%s' "${s//\"/\\\"}"; }

# lock_get <file> <field> — one field's value, or "" if the file is unreadable or
# the field is absent. Pure bash, no sed/awk: a half-written lock file can only
# ever yield "", never a crash and never a wrong answer.
lock_get() {
    local f="${1:-}" key="${2:-}" line
    [ -r "$f" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            "$key":*)
                line="${line#"$key":}"
                line="${line# }"
                printf '%s' "${line%$'\r'}"
                return 0 ;;
        esac
    done < "$f"
    return 0
}

# lock_age_min <file> — whole minutes since the lock was taken. Garbage or a
# missing since_epoch reads as 0, so a corrupt lock looks fresh rather than
# instantly expirable — an unreadable lock must never become a free pass.
lock_age_min() {
    local f="${1:-}" since now age
    case "$(lock_get "$f" since_epoch)" in
        ""|*[!0-9]*) printf '0'; return 0 ;;
    esac
    since="$(lock_get "$f" since_epoch)"
    now="$(now_epoch)"
    age=$(( now - since ))
    [ "$age" -lt 0 ] && age=0
    printf '%s' $(( age / 60 ))
}

lock_is_expired() {
    local a="${1:-0}"
    case "$a" in ""|*[!0-9]*) return 1 ;; esac
    [ "$a" -ge "$LOCK_TTL_MIN" ]
}

# lock_entries — every lock on disk as TAB-separated
#     age  holder  brief  path  file
# oldest first, so a collision report names the longest-standing holder.
lock_entries() {
    local f rows="" p h b
    [ -d "$LOCKDIR" ] || return 0
    for f in "$LOCKDIR"/*; do
        [ -f "$f" ] || continue
        p="$(lock_get "$f" path)"
        h="$(lock_get "$f" holder)"
        b="$(lock_get "$f" brief)"
        rows="${rows}$(lock_age_min "$f")${TAB}${h}${TAB}${b}${TAB}${p}${TAB}${f}"$'\n'
    done
    [ -n "$rows" ] && printf '%s' "$rows" | sort -n -k1,1
    return 0
}

# locks_on <path> — lock_entries filtered to one path.
locks_on() {
    local want="${1:-}" line age holder brief path file
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        IFS="$TAB" read -r age holder brief path file <<<"$line"
        [ "$path" = "$want" ] && printf '%s\n' "$line"
    done <<<"$(lock_entries)"
    return 0
}

# lock_brief — best-effort brief id when none was given: this instance's newest
# claim that still has no report. Advisory only; the claim markers are themselves
# unreliable, and a wrong brief here only makes one doctor warning less precise.
lock_brief() {
    local id
    [ -r "$STATE/claimed-$(my_inst)" ] || { printf '%s' "-"; return 0; }
    id="$(tail -1 "$STATE/claimed-$(my_inst)" 2>/dev/null | tr -d '[:space:]')"
    case "$id" in ""|*[!0-9]*) printf '%s' "-"; return 0 ;; esac
    if [ -n "$(report_path "$id")" ]; then printf '%s' "-"; else printf '%s' "TASK-$id"; fi
}

# write_lock <path> <brief> — atomic (temp file + rename), echoes the lock file.
write_lock() {
    local p="${1:-}" brief="${2:--}" inst f tmp
    inst="$(my_inst)"
    [ -n "$inst" ] || return 1
    mkdir -p "$LOCKDIR" 2>/dev/null || return 1
    f="$LOCKDIR/$(safe_name "$p").$inst"
    tmp="$f.tmp.$$"
    {
        printf 'path: %s\n' "$p"
        printf 'holder: %s\n' "$inst"
        printf 'brief: %s\n' "$brief"
        printf 'since: %s\n' "$(now_iso)"
        printf 'since_epoch: %s\n' "$(now_epoch)"
    } > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 1; }
    mv "$tmp" "$f" 2>/dev/null || { rm -f "$tmp"; return 1; }
    printf '%s' "$f"
    return 0
}

is_open()   { printf '%s' "$1" | grep -qi '^open'; }
is_claimed(){ printf '%s' "$1" | grep -qi '^claimed'; }
is_done()   { printf '%s' "$1" | grep -qi '^\(done\|closed\|integrated\)'; }

task_ids() {
    local f id
    for f in "$INBOX"/TASK-*.md; do
        [ -e "$f" ] || continue
        id="$(brief_id "$f")"
        [ -n "$id" ] && printf '%s\n' "$id"
    done | sort -n
}

brief_path() {
    local id="$1" f
    for f in "$INBOX"/TASK-"$id"-*.md "$INBOX"/TASK-"$id".md; do
        [ -e "$f" ] && { printf '%s\n' "$f"; return 0; }
    done
    return 1
}

report_path() {
    local id="$1"
    [ -e "$OUTBOX/TASK-$id-REPORT.md" ] && printf '%s\n' "$OUTBOX/TASK-$id-REPORT.md"
}

# last_nonempty_line <file> — the file's last non-blank line, CR/space-trimmed.
# The END check and the "what did it find instead?" report share one reader, so
# they can never disagree about what terminates a report.
last_nonempty_line() {
    grep -v '^[[:space:]]*$' "${1:-}" 2>/dev/null | tail -1 | tr -d '\r' | sed 's/[[:space:]]*$//'
}

# report_last_line <id> — last_nonempty_line of the task's report, "" if none.
report_last_line() {
    local rp; rp="$(report_path "${1:-}")"
    [ -n "$rp" ] || return 0
    last_nonempty_line "$rp"
}

# report_ok <id> -> 0 if report exists AND last non-empty line is TASK-<id>-END.
# STRICT on purpose (TASK-035): the END marker is the completion signal the whole
# protocol rests on. An older suffix shape (TASK-005-ADDENDUM-END) is NOT accepted
# — it means content was appended after completion, which is exactly what the
# marker exists to catch. Widening here would let a half-written report pass.
report_ok() {
    [ "$(report_last_line "${1:-}")" = "TASK-${1:-}-END" ]
}

# age_minutes <file>
age_minutes() {
    local f="$1" mtime now
    mtime="$(stat -c %Y "$f" 2>/dev/null || stat -f %m "$f" 2>/dev/null)" || { echo 0; return; }
    now="$(now_epoch)"
    echo $(( (now - mtime) / 60 ))
}

STALE_MIN="${FBMAIL_STALE_MIN:-45}"

# ---------------------------------------------------------------- commands

cmd_board() {
    ensure_dirs
    local out="$MB/BOARD.md" tmp="$MB/.state/.board.$$"
    {
        echo "# BOARD — $PROJECT_NAME mailbox"
        echo
        echo "> Generated by \`mailbox/bin/fbmail board\` at $(ts). Do not hand-edit."
        echo "> Protocol: \`mailbox/README.md\`. Briefs: \`INBOX/\`. Reports: \`OUTBOX/\`."
        echo
        echo "| Task | Owner | Status | Report | Claimed by | Age |"
        echo "|---|---|---|---|---|---|"
        local id bp st ow inst rp rep age flag repbad
        for id in $(task_ids); do
            bp="$(brief_path "$id")"
            st="$(brief_field "$bp" Status)"
            ow="$(norm_owner "$(brief_field "$bp" Owner)")"
            inst="$(claim_inst "$st")"
            rp="$(report_path "$id")"
            repbad=0
            if [ -n "$rp" ]; then
                if report_ok "$id"; then rep="✅ END"; else rep="⚠️ no-END"; repbad=1; fi
            else
                rep="—"
            fi
            age="$(age_minutes "$bp")m"
            flag=""
            if brief_is_malformed "$bp"; then
                # Survives a regeneration, so the next session sees the breakage.
                st="malformed"; rep="—"; flag=" ⛔malformed"
            elif [ "$repbad" = 1 ]; then
                flag=" ⛔no-END"
            elif [ -z "$rp" ] && [ -n "$inst" ] && [ "$age" -gt "$STALE_MIN" ] 2>/dev/null; then
                flag=" 🔴stale"
            elif [ -z "$rp" ] && is_open "$st"; then
                flag=" ⏳open"
            fi
            printf '| TASK-%s | %s | %s | %s | %s | %s%s |\n' \
                "$id" "${ow:--}" "$st" "$rep" "${inst:--}" "$age" "$flag"
        done
        echo
        echo "## Open nags"
        local n
        n=0
        for f in "$NAGS"/open-*.md; do [ -e "$f" ] || continue; n=$((n+1)); echo "- $(basename "$f"): $(head -1 "$f" | cut -c1-140)"; done
        [ "$n" -eq 0 ] && echo "- (none)"
        echo
        echo "## Worker health"
        for f in "$HEALTH"/*.json; do
            [ -e "$f" ] || continue
            echo "- $(basename "$f" .json): $(grep -o '"summary"[^,}]*' "$f" 2>/dev/null | head -1 | cut -d'"' -f4)"
        done
        for f in "$ALERTS"/ALERT-*.md; do [ -e "$f" ] || continue; echo "- ⚠️ $(basename "$f")"; done
    } > "$tmp" 2>/dev/null
    mv "$tmp" "$out" 2>/dev/null || cp "$tmp" "$out"
    rm -f "$tmp"
    echo "board: $out"
}

cmd_status() {
    ensure_dirs
    local json=0
    [ "${1:-}" = "--json" ] && json=1
    local id bp st ow inst rp done_n open_n claim_n miss_n stale_n mal_n badrep_n attn=0
    done_n=0; open_n=0; claim_n=0; miss_n=0; stale_n=0; mal_n=0; badrep_n=0
    local rows=""
    for id in $(task_ids); do
        bp="$(brief_path "$id")"; st="$(brief_field "$bp" Status)"; ow="$(norm_owner "$(brief_field "$bp" Owner)")"
        inst="$(claim_inst "$st")"; rp="$(report_path "$id")"
        local veredict="ok" note=""
        if brief_is_malformed "$bp"; then
            # The whole point (TASK-034): an unreadable Status must never read as
            # ok. `note` carries the path so the row is actionable.
            mal_n=$((mal_n+1)); veredict="malformed"; note="$bp"; attn=1
        elif [ -n "$rp" ]; then
            if report_ok "$id"; then
                if is_claimed "$st"; then veredict="claimed-but-reported"; fi
            else
                # A bad report outranks the claim state: it must be visible, not
                # masked as a healthy `claimed-but-reported` row (TASK-035).
                badrep_n=$((badrep_n+1)); veredict="report-no-END"; attn=1
            fi
            done_n=$((done_n+1))
        elif is_claimed "$st"; then
            claim_n=$((claim_n+1))
            local age; age="$(age_minutes "$bp")"
            if [ "$age" -gt "$STALE_MIN" ] 2>/dev/null; then
                stale_n=$((stale_n+1)); veredict="STALE (${age}m, no report)"; attn=1
            else
                veredict="in-flight (${age}m)"
            fi
        elif is_open "$st"; then
            open_n=$((open_n+1)); veredict="open"; attn=1
        fi
        rows="${rows}TASK-${id}|${ow}|${inst:-}|${st}|${veredict}|${rp:-none}|${note}"$'\n'
    done
    if [ "$json" = 1 ]; then
        printf '{"task":"%s","generated":"%s","totals":{"reported":%d,"claimed":%d,"open":%d,"stale":%d,"malformed":%d,"bad_reports":%d},"tasks":[' \
            "$(json_esc "$PROJECT_NAME")" "$(now_iso)" "$done_n" "$claim_n" "$open_n" "$stale_n" "$mal_n" "$badrep_n"
        local first=1 line
        while IFS= read -r line; do
            [ -n "$line" ] || continue
            [ "$first" = 1 ] || printf ','
            first=0
            IFS='|' read -r t o i s v r n <<<"$line"
            local m=false; [ -n "$n" ] && m=true
            printf '{"id":"%s","owner":"%s","claimer":"%s","status":"%s","verdict":"%s","report":"%s","malformed":%s,"brief":"%s"}' \
                "$(json_esc "$t")" "$(json_esc "$o")" "$(json_esc "$i")" "$(json_esc "$s")" "$(json_esc "$v")" "$(json_esc "$r")" "$m" "$(json_esc "$n")"
        done <<<"$rows"
        printf '],"locks":['
        local lfirst=1 lage lholder lbrief lpath lfile
        while IFS="$TAB" read -r lage lholder lbrief lpath lfile; do
            [ -n "${lpath:-}" ] || continue
            [ "$lfirst" = 1 ] || printf ','
            lfirst=0
            local lexp=false
            lock_is_expired "$lage" && lexp=true
            printf '{"path":"%s","holder":"%s","brief":"%s","age_min":%s,"expired":%s}' \
                "$(json_esc "$lpath")" "$(json_esc "$lholder")" "$(json_esc "$lbrief")" "$lage" "$lexp"
        done <<<"$(lock_entries)"
        printf ']}\n'
    else
        echo "=== $PROJECT_NAME mailbox status ($(ts)) ==="
        echo "root: $ROOT"
        echo "reported=$done_n claimed=$claim_n open=$open_n stale=$stale_n malformed=$mal_n bad-reports=$badrep_n  (stale threshold ${STALE_MIN}m)"
        echo
        while IFS='|' read -r line; do
            [ -n "$line" ] || continue
            IFS='|' read -r t o i s v r n <<<"$line"
            printf '%-9s %-4s %-5s %-28s %s\n' "$t" "${o:--}" "${i:--}" "$v" "$r"
        done <<<"$rows"
        if [ "$mal_n" -gt 0 ]; then
            echo
            echo "--- malformed briefs (Status unreadable) ---"
            while IFS='|' read -r line; do
                [ -n "$line" ] || continue
                IFS='|' read -r t o i s v r n <<<"$line"
                [ -n "$n" ] || continue
                printf '* %s — %s\n  fix: add a list-form `- Status: open` (or `- Status: claimed by <inst> <time>`) under the title.\n' "$t" "$n"
            done <<<"$rows"
        fi
        if [ "$badrep_n" -gt 0 ]; then
            echo
            echo "--- reports not terminated by TASK-<id>-END ---"
            while IFS='|' read -r line; do
                [ -n "$line" ] || continue
                IFS='|' read -r t o i s v r n <<<"$line"
                [ "$v" = "report-no-END" ] || continue
                printf '* %s — %s\n  last non-empty line: [%s]\n  fix: append `TASK-%s-END` as the last non-empty line.\n' \
                    "$t" "$r" "$(last_nonempty_line "$r")" "${t#TASK-}"
            done <<<"$rows"
        fi
        echo
        echo "--- open nags ---"
        local n=0 f
        for f in "$NAGS"/open-*.md; do [ -e "$f" ] || continue; n=$((n+1)); echo "* $(basename "$f")"; done
        [ "$n" -eq 0 ] && echo "(none)"
        echo "--- alerts ---"
        n=0
        for f in "$ALERTS"/ALERT-*.md; do [ -e "$f" ] || continue; n=$((n+1)); echo "* $(basename "$f")"; done
        [ "$n" -eq 0 ] && echo "(none)"
        # Advisory locks (TASK-027). Deliberately NOT counted into `attn`: a stale
        # lock is reported here and warned about in `doctor`, but it must never be
        # able to fail a worker's status gate.
        echo "--- file locks ---"
        n=0
        local lage lholder lbrief lpath lfile
        while IFS="$TAB" read -r lage lholder lbrief lpath lfile; do
            [ -n "${lpath:-}" ] || continue
            n=$((n+1))
            if lock_is_expired "$lage"; then
                echo "* ${lpath} — ${lholder} (${lbrief}, ${lage}m) STALE (>${LOCK_TTL_MIN}m TTL)"
            else
                echo "* ${lpath} — ${lholder} (${lbrief}, ${lage}m)"
            fi
        done <<<"$(lock_entries)"
        [ "$n" -eq 0 ] && echo "(none)"
    fi
    return $([ "$attn" = 1 ] && echo 2 || echo 0)
}

cmd_claim() {
    local id="${1:-}" inst="${2:-}"
    [ -n "$id" ] && [ -n "$inst" ] || { echo "usage: fbmail claim <id> <inst>" >&2; exit 1; }
    ensure_dirs   # $STATE/ must exist before the claim marker is appended
    # One identity, so the brief and the marker file can never disagree about
    # who holds the task. `claim 025 freebuff3` used to record
    # "claimed by freebuff3" in the brief while appending 025 to
    # .state/claimed-freebuff3 — a file no reader looks at, because every
    # reader canonicalises to claimed-fb3 (TASK-027).
    local cinst; cinst="$(canon_inst "$inst")"; [ -n "$cinst" ] || cinst="$inst"
    local bp; bp="$(brief_path "$id")" || { echo "fbmail: no brief TASK-$id" >&2; exit 1; }
    # Atomic per-brief claim lock. Reading Status, rewriting it and verifying it
    # were three steps with a gap: two instances claiming in the same second
    # both passed the "already claimed?" read and both reported success. `mkdir`
    # is atomic, so exactly one holder ever proceeds.
    local claimlock="$STATE/claim-$id"
    if ! mkdir "$claimlock" 2>/dev/null; then
        # A holder that died mid-claim must not wedge the brief forever.
        if [ "$(age_minutes "$claimlock")" -ge 5 ]; then
            rm -rf "$claimlock"
            mkdir "$claimlock" 2>/dev/null || { echo "fbmail: TASK-$id claim busy; retry" >&2; exit 2; }
        else
            echo "fbmail: TASK-$id is being claimed by another instance right now; retry" >&2; exit 2
        fi
    fi
    trap 'rmdir "$claimlock" 2>/dev/null' EXIT
    local st; st="$(brief_field "$bp" Status)"
    # Malformed briefs are refused, not silently rewritten: an unreadable Status
    # means we cannot tell what state we are claiming over (TASK-034).
    if [ -z "$st" ]; then
        echo "fbmail: TASK-$id is MALFORMED — no readable Status in $bp" >&2
        echo '        add `- Status: open` under the title, then retry claim.' >&2
        exit 2
    fi
    if is_claimed "$st" && [ "$(claim_inst "$st")" != "$cinst" ]; then
        echo "fbmail: TASK-$id already claimed ($st)" >&2; exit 2
    fi
    if is_claimed "$st"; then echo "already claimed by $cinst"; rmdir "$claimlock" 2>/dev/null; trap - EXIT; return 0; fi
    # The list form is authoritative for writing: rewrite it when present, insert
    # it when a tolerated bold-header brief has none.
    set_brief_status "$bp" "claimed by ${cinst} $(now_iso)" \
      || { echo "fbmail: could not update $bp" >&2; exit 1; }
    # Fail loudly rather than leaving .state and the brief disagreeing, and make
    # sure WE are the recorded holder — a lost race must not look like a win.
    local nowst; nowst="$(brief_field "$bp" Status)"
    if ! is_claimed "$nowst"; then
        echo "fbmail: TASK-$id claim NOT recorded: no '- Status:' line in $bp" >&2; exit 1
    fi
    if [ "$(claim_inst "$nowst")" != "$cinst" ]; then
        echo "fbmail: TASK-$id claim lost to $(claim_inst "$nowst")" >&2; exit 2
    fi
    printf '%s\n' "$id" >> "$STATE/claimed-$cinst"
    rmdir "$claimlock" 2>/dev/null; trap - EXIT
    sort -u "$STATE/claimed-$cinst" -o "$STATE/claimed-$cinst" 2>/dev/null || true
    echo "claimed TASK-$id by $cinst"
}

cmd_check() {
    local id="${1:-}"
    [ -n "$id" ] || { echo "usage: fbmail check <id>" >&2; exit 1; }
    # A malformed brief has no readable Status, so "is the report there?" is the
    # wrong question — say what is actually broken and name the fix.
    local bp; bp="$(brief_path "$id")"
    if [ -n "$bp" ] && brief_is_malformed "$bp"; then
        echo "TASK-$id: MALFORMED brief — no readable Status in $bp"
        echo '  fix: add `- Status: open` (or `- Status: claimed by <inst> <time>`) under the title.'
        exit 3
    fi
    local rp; rp="$(report_path "$id")"
    # Not-yet-finished is exit 1, NOT 2: a CI-style gate has to be able to tell
    # "still running" from "finished but corrupt" (TASK-039 / audit F10).
    if [ -z "$rp" ]; then echo "TASK-$id: NO REPORT (not finished)"; exit 1; fi
    if report_ok "$id"; then echo "TASK-$id: OK ($rp)"; return 0; fi
    echo "TASK-$id: report exists but TASK-$id-END is not the last non-empty line ($rp)"
    echo "  last non-empty line: [$(report_last_line "$id")]"
    exit 2
}

cmd_done() {
    local id="${1:-}"
    [ -n "$id" ] || { echo "usage: fbmail done <id>" >&2; exit 1; }
    local bp; bp="$(brief_path "$id")" || { echo "fbmail: no brief TASK-$id" >&2; exit 1; }
    if brief_is_malformed "$bp"; then
        echo "fbmail: TASK-$id is MALFORMED — no readable Status in $bp" >&2
        echo '        add `- Status: open` under the title, then retry.' >&2
        exit 2
    fi
    # Refuse to close a brief another instance is actively holding (TASK-039 / F11).
    # `done` used to write "done" no matter who called it or what state the brief was
    # in, so any instance could close a worker's live lane under it — and the board
    # would agree the task was finished.
    #
    # Deliberately fail-OPEN where freshness cannot be proven: a claim with no
    # parseable timestamp, or one already past STALE_MIN, is treated as orphaned and
    # the Lead may close it. Recourse matters — three lanes were lost to stale claims.
    local st holder claimed_at age
    st="$(brief_field "$bp" Status)"
    holder="$(claim_inst "$st")"
    if [ -n "$holder" ] && [ "$holder" != "$(my_inst)" ]; then
        claimed_at="$(printf '%s' "$st" | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}' | head -1)"
        if [ -n "$claimed_at" ]; then
            age=$(( ( $(now_epoch) - $(date -d "$claimed_at" +%s 2>/dev/null || echo 0) ) / 60 ))
            if [ "$age" -ge 0 ] && [ "$age" -lt "$STALE_MIN" ]; then
                echo "fbmail: TASK-$id is held by $holder (claimed ${age}m ago, still fresh) — refusing to close." >&2
                echo "        let the holder report, wait for the claim to age past ${STALE_MIN}m, or Bus/NAG the Lead." >&2
                exit 2
            fi
        fi
    fi
    set_brief_status "$bp" "done (Lead $(now_iso))" \
      || { echo "fbmail: could not update $bp" >&2; exit 1; }
    echo "TASK-$id marked done"
}

cmd_nag() {
    ensure_dirs
    local n=0 f
    for f in "$NAGS"/open-*.md; do
        [ -e "$f" ] || continue
        n=$((n+1))
        echo "=== $(basename "$f") ($(age_minutes "$f")m old) ==="
        cat "$f"
        echo
    done
    [ "$n" -eq 0 ] && echo "no open nags"
}

cmd_nag_done() {
    local f="${1:-}" answer="${2:-}"
    [ -n "$f" ] || { echo "usage: fbmail nag-done <file|topic> <answer>" >&2; exit 1; }
    local src="$f"
    [ -e "$src" ] || src="$NAGS/open-$f.md"
    [ -e "$src" ] || src="$NAGS/$f"
    [ -e "$src" ] || { echo "fbmail: no such nag: $f" >&2; exit 1; }
    local base dest; base="$(basename "$src")"; dest="$NAGS/done-${base#open-}"
    {
        echo "# NAG answered by Lead — $(ts)"
        echo
        echo "## Asked"
        cat "$src"
        echo
        echo "## Answer"
        echo "$answer"
    } > "$dest"
    rm -f "$src"
    echo "nag triaged: $dest"
}

cmd_send() {
    local inst="${1:-}" text="${2:-}"
    [ -n "$inst" ] && [ -n "$text" ] || { echo "usage: fbmail send <inst> <text>" >&2; exit 1; }
    ensure_dirs
    local stamp; stamp="$(date '+%Y-%m-%dT%H%M')"
    # The sender, not a constant. This used to hardcode "lead" in both the
    # filename and the body, so a worker's note was filed and read as if the
    # Lead wrote it — the same silent-misattribution class as the claim markers
    # that split by instance alias (TASK-027). Only the two worker identities
    # are named for themselves; every other identity (including the Lead's own
    # session, whatever FB_INSTANCE it runs under) keeps the historical
    # `lead-to-` name byte-for-byte, so nothing the Lead reads changes.
    local from; from="$(send_from)"
    local f="$BUS/$(date '+%Y%m%dT%H%M')-${from}-to-${inst}.md"
    {
        echo "# to: ${inst} (from ${from}, $(now_iso))"
        echo
        echo "$text"
    } > "$f"
    # .fb-mailbox compatibility: fb3's session drops notes there.
    local compat="$ROOT/.fb-mailbox"
    mkdir -p "$compat" 2>/dev/null || true
    cp "$f" "$compat/from-${from}-${stamp}.md" 2>/dev/null || true
    echo "sent: $f"
}

cmd_health() {
    ensure_dirs
    local f
    for f in "$HEALTH"/*.json; do
        [ -e "$f" ] || continue
        echo "=== $(basename "$f" .json) ($(age_minutes "$f")m old) ==="
        cat "$f"
        echo
    done
}

# ---------------------------------------------------------------- doctor

DOCTOR_FIX=0

env_set_go() {
    # Write ~/.config/go/env so every future shell in this instance inherits a
    # working module route. NEVER points at the banned mirror (AGENTS.md policy).
    #
    # Offline-first: when the repo ships vendor/ (or the existing file already
    # says GOPROXY=off), write the same offline set tools/fleet-bootstrap.sh
    # writes — GOFLAGS=-mod=vendor GOPROXY=off GOSUMDB=off. A network proxy is
    # only written when there is no vendor tree to build from. An existing
    # GOPROXY=off is NEVER upgraded to a network proxy: that would make a
    # container need the network to build, which the offline layer exists to
    # prevent.
    local dir="${HOME:-/root}/.config/go"
    mkdir -p "$dir" 2>/dev/null || return 1
    local f="$dir/env"
    local prev_proxy=""
    [ -f "$f" ] && prev_proxy="$(sed -n 's/^GOPROXY=//p' "$f" | head -1)"
    local proxy sumdb flags
    if [ -d "$ROOT/vendor" ] || [ "$prev_proxy" = "off" ]; then
        proxy="off"; sumdb="off"; flags="-mod=vendor"
    else
        proxy="https://goproxy.cn,https://proxy.golang.org,direct"
        sumdb="sum.golang.google.cn"; flags="-mod=mod"
    fi
    # Preserve keys this tool does not manage, so a repair never silently drops
    # e.g. GOPRIVATE or GONOSUMDB that another tool put there.
    local keep=""
    [ -f "$f" ] && keep="$(grep -vE '^[[:space:]]*(GOPROXY|GOSUMDB|GOTOOLCHAIN|GOFLAGS|GOPATH)=' "$f" | grep -v '^# managed by fbmail doctor')"
    local body
    body="$(printf '%s\n' \
        "# managed by fbmail doctor — $PROJECT_NAME fleet" \
        "GOPROXY=$proxy" \
        "GOSUMDB=$sumdb" \
        "GOTOOLCHAIN=local" \
        "GOFLAGS=$flags" \
        "GOPATH=${HOME:-/root}/go")"
    [ -n "$keep" ] && body="$body"$'\n'"$keep"
    # Idempotent: only write on a real change, so repeated `doctor --fix` runs
    # leave the file byte-identical (no timestamp churn).
    if [ -f "$f" ] && [ "$(cat "$f" 2>/dev/null)" = "$body" ]; then
        echo "  $f already correct (GOPROXY=$proxy, GOFLAGS=$flags)"
        return 0
    fi
    printf '%s\n' "$body" > "$f" 2>/dev/null && echo "  wrote $f (GOPROXY=$proxy, GOFLAGS=$flags)"
}

doctor() {
    local inst="${FB_INSTANCE:-$(hostname 2>/dev/null || echo host)}"
    local problems=0 fixed=0
    local out="$HEALTH/$inst.json"
    ensure_dirs
    echo "=== fbmail doctor — instance '$inst' ($(ts)) ==="
    echo "root: $ROOT"
    echo "FB_INSTANCE=${FB_INSTANCE:-unset} FB_ROLE=${FB_ROLE:-unset}"

    # 1. go toolchain
    local gobin="" goversion="" gofound=0
    if command -v go >/dev/null 2>&1; then
        gobin="$(command -v go)"; goversion="$(go version 2>/dev/null)"
        gofound=1
        echo "[ok]   go: $goversion ($gobin)"
    else
        echo "[FAIL] go: not on PATH"
        problems=$((problems+1))
        # Find a toolchain installed by a previous session.
        local cand=""
        for cand in "${HOME:-/root}/toolchain/go/bin/go" "${HOME:-/root}/toolchains"/go*/bin/go "${HOME:-/root}/sdk"/go*/bin/go /usr/local/go/bin/go; do
            [ -x "$cand" ] && break; cand=""
        done
        if [ -n "$cand" ]; then
            echo "       found toolchain at $cand"
            if [ "$DOCTOR_FIX" = 1 ]; then
                mkdir -p "${HOME:-/root}/.local/bin" 2>/dev/null
                ln -sf "$cand" "${HOME:-/root}/.local/bin/go" 2>/dev/null
                ln -sf "$(dirname "$cand")/gofmt" "${HOME:-/root}/.local/bin/gofmt" 2>/dev/null
                echo "       fixed: symlinked go/gofmt into ~/.local/bin (ensure it is on PATH)"
                fixed=$((fixed+1))
            fi
            gobin="$cand"
        else
            echo "       no toolchain found."
            echo "       install (offline-first):"
            echo "         tarball cache: ${FBMAIL_TOOLCHAIN_CACHE:-/mnt/home-shai/.cache/toolchains}/"
            echo "         tar -C \"\$HOME\" -xzf .../go1.26.8.linux-amd64.tar.gz && ln -s \$HOME/go/bin/go \$HOME/.local/bin/go"
            echo "         online fallback: https://mirrors.aliyun.com/golang/go1.26.8.linux-amd64.tar.gz"
        fi
    fi

    # 2. go env file
    local goenv="${HOME:-/root}/.config/go/env"
    if [ -f "$goenv" ] && grep -q 'GOPROXY' "$goenv" 2>/dev/null; then
        echo "[ok]   go env file: $(grep GOPROXY "$goenv" | head -1)"
    else
        echo "[warn] go env file missing/without GOPROXY ($goenv)"
        problems=$((problems+1))
        if [ "$DOCTOR_FIX" = 1 ]; then
            env_set_go && fixed=$((fixed+1))
        else
            echo "       (rerun with --fix to set goproxy.cn,proxy.golang.org + GOTOOLCHAIN=local)"
        fi
    fi

    # 3. proxy env sanity: a foreign exit IP breaks Go/NPM mirror routes
    local pvars=""
    local v
    for v in http_proxy https_proxy HTTP_PROXY HTTPS_PROXY all_proxy ALL_PROXY; do
        eval "val=\${$v:-}"; [ -n "$val" ] && pvars="$pvars $v=$val"
    done
    if [ -n "$pvars" ]; then
        echo "[warn] proxy env set:$pvars"
        case "${NO_PROXY:-}${no_proxy:-}" in
            *127.0.0.1*|*localhost*) echo "       NO_PROXY ok (localhost bypassed)" ;;
            *) echo "       NO_PROXY MISSING 127.0.0.1,localhost — localhost calls may be hijacked"
               problems=$((problems+1))
               if [ "$DOCTOR_FIX" = 1 ]; then
                   echo '       export NO_PROXY=127.0.0.1,localhost in ~/.bashrc'
                   if ! grep -q 'NO_PROXY=127.0.0.1,localhost' "${HOME:-/root}/.bashrc" 2>/dev/null; then
                       printf '\n# fbmail doctor: never proxy localhost\nexport NO_PROXY=127.0.0.1,localhost\nexport no_proxy=127.0.0.1,localhost\n' >> "${HOME:-/root}/.bashrc"
                       fixed=$((fixed+1))
                   fi
               fi ;;
        esac
        echo "       note: Iranian mirrors must NOT be reached through the proxy; Go module"
        echo "             fetch from a proxied shell may geo-403 — unset proxy vars for go builds."
    else
        echo "[ok]   no proxy env set (direct egress)"
    fi

    # 4. module route reachability (best effort, short timeout)
    if [ -n "$gobin" ]; then
        local code
        if command -v curl >/dev/null 2>&1; then
            code="$(timeout 12 curl -s -o /dev/null -w '%{http_code}' https://goproxy.cn/github.com/yaa110/go-persian-calendar/@v/list 2>/dev/null)"
            [ "$code" = "200" ] && echo "[ok]   goproxy.cn reachable" || { echo "[warn] goproxy.cn -> ${code:-no-response}"; problems=$((problems+1)); }
        fi
    fi

    # 5. node / bun
    for t in node npm bun git sqlite3; do
        if command -v "$t" >/dev/null 2>&1; then echo "[ok]   $t: $("$t" --version 2>/dev/null | head -1)"; else echo "[info] $t: absent"; fi
    done

    # 6. project writability + mailbox
    if [ -w "$ROOT" ]; then echo "[ok]   project writable ($ROOT)"; else echo "[FAIL] project NOT writable ($ROOT)"; problems=$((problems+1)); fi
    echo "[ok]   mailbox: $(ls "$INBOX"/TASK-*.md 2>/dev/null | wc -l) briefs, $(ls "$OUTBOX"/*-REPORT.md 2>/dev/null | wc -l) reports"

    # 7. disk
    local avail; avail="$(df -Pk "$ROOT" 2>/dev/null | awk 'NR==2{print int($4/1024)}')"
    if [ -n "$avail" ] && [ "$avail" -lt 1024 ] 2>/dev/null; then
        echo "[warn] disk free: ${avail}MB"; problems=$((problems+1))
    else
        echo "[ok]   disk free: ${avail:-?}MB"
    fi

    # 8. toolchain cache
    local cache="${FBMAIL_TOOLCHAIN_CACHE:-/mnt/home-shai/.cache/toolchains}"
    if [ -d "$cache" ] && ls "$cache"/go*.tar.gz >/dev/null 2>&1; then
        echo "[ok]   toolchain cache: $(ls "$cache"/go*.tar.gz | xargs -n1 basename | tr '\n' ' ')"
    else
        echo "[info] toolchain cache empty ($cache) — installs will need ~67MB download"
    fi

    # 9. advisory file locks (TASK-027). A lock NEVER fails doctor and never
    # touches `problems`: locks are advisory, and an advisory lock that can fail
    # or block a session start is the failure mode of every naive lock.
    local lage lholder lbrief lpath lfile lcount=0 lrep
    while IFS="$TAB" read -r lage lholder lbrief lpath lfile; do
        [ -n "${lpath:-}" ] || continue
        lcount=$((lcount+1))
        lrep=""
        case "$lbrief" in TASK-*) lrep="$(report_path "${lbrief#TASK-}")" ;; esac
        if lock_is_expired "$lage"; then
            if [ -n "$lrep" ]; then
                echo "[warn] leftover lock (${lage}m >= ${LOCK_TTL_MIN}m TTL, brief $lbrief already reported)"
                echo "       $lpath held by $lholder — clear with: fbmail unlock --expired"
            else
                echo "[warn] STALE lock: $lpath held by $lholder (brief $lbrief, ${lage}m >= ${LOCK_TTL_MIN}m TTL, no report)"
                echo "       clear with: fbmail unlock --expired  (never break a LIVE lock: NAG/BUS the Lead)"
            fi
        else
            echo "[info] lock: $lpath held by $lholder (brief $lbrief, ${lage}m of ${LOCK_TTL_MIN}m TTL)"
        fi
    done <<<"$(lock_entries)"
    [ "$lcount" -eq 0 ] && echo "[ok]   file locks: none held"

    local summary="go=$([ "$gofound" = 1 ] && echo ok || echo missing) problems=$problems fixed=$fixed"
    printf '{"instance":"%s","role":"%s","generated":"%s","root":"%s","go":"%s","problems":%d,"fixed":%d,"summary":"%s"}\n' \
        "$inst" "${FB_ROLE:-unknown}" "$(now_iso)" "$ROOT" "$goversion" "$problems" "$fixed" "$summary" > "$out" 2>/dev/null
    echo
    echo "--- $summary ---"
    echo "health written: $out"
    return 0
}

# ---------------------------------------------------------------- watch

cmd_watch() {
    local interval="${FBMAIL_POLL:-60}" once=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --interval) interval="${2:-60}"; shift 2 ;;
            --once) once=1; shift ;;
            *) shift ;;
        esac
    done
    local me="${FB_INSTANCE:-}"
    # canon_inst maps freebuff2→fb2 (and fb2→fb2). The old `${me#freebuff}`
    # yielded "2", and the equality guard blanked "fb2"/"fb3", so the owner
    # comparison never matched and watch never auto-claimed anything.
    local inst; inst="$(canon_inst "$me")"
    ensure_dirs
    echo "fbmail watch: instance='${me:-unknown}' interval=${interval}s root=$ROOT"
    while :; do
        for id in $(task_ids); do
            local bp st ow seen_marker
            bp="$(brief_path "$id")"
            st="$(brief_field "$bp" Status)"
            ow="$(norm_owner "$(brief_field "$bp" Owner)")"
            seen_marker="$STATE/seen-TASK-$id"
            [ -e "$seen_marker" ] && continue
            touch "$seen_marker"
            echo "$(ts) NEW TASK-$id owner=$ow status=$st"
            if [ -n "$inst" ] && [ "$ow" = "$inst" ] && is_open "$st"; then
                cmd_claim "$id" "$inst" || true
            fi
        done
        # stale-claim / missing-report alerts
        for id in $(task_ids); do
            local bp st rp age alert
            bp="$(brief_path "$id")"; st="$(brief_field "$bp" Status)"; rp="$(report_path "$id")"
            alert="$ALERTS/ALERT-TASK-$id.md"
            if [ -n "$rp" ] && [ ! -e "$alert" ]; then
                report_ok "$id" || {
                    printf '# ALERT TASK-%s\n%s report exists but is not END-terminated (%s).\nLast non-empty line: [%s] — append `TASK-%s-END`.\n' \
                        "$id" "$(ts)" "$rp" "$(report_last_line "$id")" "$id" > "$alert"
                    echo "$(ts) ALERT TASK-$id report not END-terminated"
                }
            fi
            if [ -z "$rp" ] && is_claimed "$st"; then
                age="$(age_minutes "$bp")"
                if [ "$age" -gt "$STALE_MIN" ] 2>/dev/null; then
                    if [ ! -e "$alert" ]; then
                        printf '# ALERT TASK-%s\n%s claimed ("%s") for %sm with no report in OUTBOX/.\nAction: verify files on disk, then write the report or re-open.\n' \
                            "$id" "$(ts)" "$st" "$age" > "$alert"
                        echo "$(ts) ALERT TASK-$id stale claim (${age}m, no report)"
                    fi
                fi
            fi
            [ -e "$alert" ] && [ -n "$rp" ] && rm -f "$alert"
        done
        cmd_board >/dev/null 2>&1 || true
        [ "$once" = 1 ] && break
        sleep "$interval"
    done
}

# ---------------------------------------------------------------- lock/unlock

# cmd_lock <path>... [-b TASK-XXX]
# Two passes on purpose: every path is checked for a LIVE holder before anything
# is written, so a refusal never leaves a half-locked set that the caller would
# mistake for a complete one. Exit 2 when refused, and the refusal is loud.
cmd_lock() {
    local brief="" paths="" bad=0 line p
    while [ $# -gt 0 ]; do
        case "$1" in
            -b) brief="${2:-}"; shift; [ $# -gt 0 ] && shift ;;
            -b*) brief="${1#-b}"; shift ;;
            --) shift; while [ $# -gt 0 ]; do paths="${paths}${1}"$'\n'; shift; done ;;
            -*) echo "fbmail: lock: unknown option '$1'" >&2; exit 1 ;;
            *) paths="${paths}${1}"$'\n'; shift ;;
        esac
    done
    local inst; inst="$(my_inst)"
    [ -n "$inst" ] || { echo "fbmail: cannot determine instance (set FB_INSTANCE)" >&2; exit 1; }
    [ -n "$paths" ] || { echo "usage: fbmail lock <path> [path...] [-b TASK-XXX]" >&2; exit 1; }
    [ -n "$brief" ] || brief="$(lock_brief)"
    mkdir -p "$LOCKDIR" 2>/dev/null || true

    # pass 1 — validate every path before writing any lock
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        p="$(norm_path "$line")" || {
            printf 'fbmail: refusing "%s": empty, or contains a tab/newline\n' "$line" >&2
            bad=1; continue; }
        local age holder lbrief lpath lfile
        while IFS="$TAB" read -r age holder lbrief lpath lfile; do
            [ -n "${holder:-}" ] || continue
            [ "$holder" = "$inst" ] && continue
            if lock_is_expired "$age"; then
                printf 'fbmail: WARNING — %s had a STALE lock from %s (brief %s, %sm >= %sm TTL); taking it over\n' \
                    "$p" "$holder" "$lbrief" "$age" "$LOCK_TTL_MIN" >&2
                rm -f "$lfile" 2>/dev/null || true
            else
                printf 'fbmail: REFUSED — %s is LOCKED by %s (brief %s, held %sm, TTL %sm)\n' \
                    "$p" "$holder" "$lbrief" "$age" "$LOCK_TTL_MIN" >&2
                printf '         do NOT break a live lock: NAG or BUS the Lead, or pick another file.\n' >&2
                printf '         at %sm+ it is stale and `fbmail unlock --expired` clears it.\n' \
                    "$LOCK_TTL_MIN" >&2
                bad=1
            fi
        done <<<"$(locks_on "$p")"
    done <<<"$paths"
    [ "$bad" = 1 ] && exit 2

    # pass 2 — write. Re-locking your own file is a refresh, so this is idempotent.
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        p="$(norm_path "$line")" || continue
        local f
        if f="$(write_lock "$p" "$brief")" && [ -n "$f" ]; then
            printf 'locked: %-40s (holder %s, brief %s, stale after %sm)\n' "$p" "$inst" "$brief" "$LOCK_TTL_MIN"
        else
            printf 'fbmail: could not write a lock for %s\n' "$p" >&2
            exit 1
        fi
    done <<<"$paths"
    return 0
}

# cmd_unlock <path>... | --all | --expired
# Safe to call when you hold nothing — an unattended worker's last act is often a
# cleanup it is not sure it needs. Never removes a LIVE lock held by someone else:
# that exits 2 and points at --expired if the lock is genuinely stale.
cmd_unlock() {
    [ $# -gt 0 ] || { echo "usage: fbmail unlock <path> [path...] | --all | --expired" >&2; exit 1; }
    local inst; inst="$(my_inst)"
    local mode=paths n=0
    case "${1:-}" in
        --all) mode=all ;;
        --expired) mode=expired ;;
    esac

    if [ "$mode" != paths ]; then
        local age holder brief path file
        while IFS="$TAB" read -r age holder brief path file; do
            [ -n "${path:-}" ] || continue
            if [ "$mode" = all ]; then
                [ "$holder" = "$inst" ] || continue
                if rm -f "$file" 2>/dev/null; then
                    printf 'unlocked: %s (held by %s, brief %s)\n' "$path" "$holder" "$brief"; n=$((n+1))
                fi
            else
                lock_is_expired "$age" || continue
                if rm -f "$file" 2>/dev/null; then
                    printf 'unlocked (stale): %s (held by %s, brief %s, %sm)\n' "$path" "$holder" "$brief" "$age"; n=$((n+1))
                fi
            fi
        done <<<"$(lock_entries)"
        if [ "$mode" = all ]; then
            [ "$n" -eq 0 ] && echo "fbmail: no locks held by ${inst:-unknown} (nothing to do)"
        else
            [ "$n" -eq 0 ] && echo "fbmail: no stale locks (TTL ${LOCK_TTL_MIN}m — nothing to do)"
        fi
        return 0
    fi

    local bad=0 arg norm found age holder brief path file
    for arg in "$@"; do
        case "$arg" in
            -*) echo "fbmail: unlock: unknown option '$arg'" >&2; exit 1 ;;
        esac
        norm="$(norm_path "$arg")" || {
            printf 'fbmail: ignoring "%s": empty, or contains a tab/newline\n' "$arg" >&2; continue; }
        found=0
        while IFS="$TAB" read -r age holder brief path file; do
            [ -n "${path:-}" ] || continue
            found=1
            if [ "$holder" = "$inst" ] || lock_is_expired "$age"; then
                rm -f "$file" 2>/dev/null && printf 'unlocked: %s (held by %s, brief %s)\n' "$path" "$holder" "$brief"
            else
                printf 'fbmail: REFUSED — %s is LOCKED by %s (brief %s, %sm, TTL %sm); not yours to remove\n' \
                    "$path" "$holder" "$brief" "$age" "$LOCK_TTL_MIN" >&2
                printf '         NAG or BUS the Lead. Do not break a live lock.\n' >&2
                bad=1
            fi
        done <<<"$(locks_on "$norm")"
        [ "$found" = 0 ] && printf 'fbmail: no lock on %s (nothing to do)\n' "$norm"
    done
    [ "$bad" = 1 ] && exit 2
    return 0
}

# ---------------------------------------------------------------- main

cmd_help() {
    # Print the comment banner as a block instead of a hard-coded line range:
    # `3,30p` leaked `set -u` and `VERSION=` into the help output and silently
    # truncated the usage the moment a command was added above it.
    sed -n '3,/^[^#]/p' "$0" | sed 's/^# \{0,1\}//' | sed '$d'
}

COMMAND="${1:-help}"
[ $# -gt 0 ] && shift

case "$COMMAND" in
    board)      cmd_board "$@" ;;
    status)     cmd_status "$@" ;;
    claim)      cmd_claim "$@" ;;
    lock)       cmd_lock "$@" ;;
    unlock)     cmd_unlock "$@" ;;
    check)      cmd_check "$@" ;;
    done)       cmd_done "$@" ;;
    nag)        cmd_nag "$@" ;;
    nag-done)   cmd_nag_done "$@" ;;
    send)       cmd_send "$@" ;;
    health)     cmd_health "$@" ;;
    doctor)     [ "${1:-}" = "--fix" ] && DOCTOR_FIX=1; doctor ;;
    watch)      cmd_watch "$@" ;;
    version)    echo "fbmail $VERSION" ;;
    help|-h|--help) cmd_help ;;
    *) echo "fbmail: unknown command '$COMMAND'" >&2; cmd_help; exit 1 ;;
esac
