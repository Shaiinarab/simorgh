{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    // ES2022 + Node types. Unlike phoenix-core, this package is host-side and is
    // allowed to use Node built-ins freely — it *is* the host. The portability
    // constraint belongs to the engine, and keeping it there is the point.
    "lib": ["ES2022"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
