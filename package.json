{
  "name": "simorgh-platform",
  "version": "2.0.0",
  "description": "Free-to-run, no-KYC, self-evolving agentic AI gateway that federates fragmented free tiers into one resilient flock.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "deploy": "npm run typecheck && wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:dry-run": "wrangler deploy --dry-run --outdir dist",
    "security:check": "npm audit --omit=dev && tsgo --noEmit && wrangler deploy --dry-run --outdir dist"
  },
  "keywords": [
    "ai-agents",
    "api-gateway",
    "api-federation",
    "cloudflare-workers",
    "edge-computing",
    "hono",
    "typescript",
    "mcp",
    "no-kyc",
    "free-tier"
  ],
  "author": "Shahin Arab",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.132.0"
  },
  "dependencies": {
    "hono": "^4.13.8"
  },
  "engines": {
    "node": ">=20"
  }
}
