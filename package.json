{
  "name": "simorgh-platform",
  "version": "2.0.0",
  "description": "Free-to-run, no-KYC, self-evolving agentic AI gateway that federates fragmented free tiers into one resilient flock.",
  "type": "module",
  "main": "src/index.ts",
  "workspaces": [
    "phoenix-core",
    "simorgh-platform"
  ],
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "deploy": "npm run typecheck && wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsgo --noEmit && tsgo --noEmit -p phoenix-core/tsconfig.json && tsgo --noEmit -p simorgh-platform/tsconfig.json",
    "test": "npm run test:workers && npm run test:node",
    "test:workers": "vitest run",
    "test:node": "vitest run --config vitest.node.config.ts",
    "test:watch": "vitest",
    "simorgh": "node simorgh-platform/src/cli.ts",
    "platform:smoke": "node simorgh-platform/src/runtimes/smoke.ts",
    "e2e:ask": "node simorgh-platform/scripts/e2e-ask.ts",
    "cf:dry-run": "wrangler deploy --dry-run --outdir dist",
    "security:scan": "bash scripts/security-scan.sh",
    "security:check": "npm run security:scan && tsgo --noEmit && wrangler deploy --dry-run --outdir dist",
    "go:build": "GOFLAGS=-mod=readonly go build all",
    "go:test": "GOFLAGS=-mod=readonly go test github.com/shaiinarab/simorgh/... -count=1",
    "go:vet": "GOFLAGS=-mod=readonly go vet github.com/shaiinarab/simorgh/...",
    "runtime:bun": "bun run simorgh-platform/src/runtimes/bun.ts",
    "e2e:bun": "bun simorgh-platform/scripts/e2e-bun.ts"
  },
  "keywords": [
    "ai-agents",
    "api-gateway",
    "api-federation",
    "cloudflare-workers",
    "edge-computing",
    "hono",
    "typescript",
    "mcp",
    "no-kyc",
    "free-tier"
  ],
  "author": "Shahin Arab",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^22.20.4",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.132.0"
  },
  "dependencies": {
    "hono": "^4.13.8"
  },
  "engines": {
    "node": ">=20"
  }
}
