{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],

    // No "@cloudflare/workers-types". As of Wrangler 4.132, `wrangler types` emits
    // *runtime types* (generated from the bundled workerd) and supersedes that package
    // outright — wrangler prints the instruction itself. Runtime globals (Ai,
    // KVNamespace, DurableObjectNamespace, DurableObjectState) now come from
    // ./worker-configuration.d.ts, listed in `include` below. Keeping both would mean
    // two copies of every global.
    //
    // `@cloudflare/vitest-pool-workers/types` supplies the `cloudflare:test` module
    // declaration (fetchMock, runInDurableObject, SELF). Note the subpath: the package
    // root resolves to the *pool* API, not the test-side module.
    "types": ["@cloudflare/vitest-pool-workers/types"],

    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  // These are *inputs*, not `types` entries: TypeScript expects package names under
  // `types`, and silently resolves nothing if handed a file path.
  //   worker-configuration.d.ts — generated by `wrangler types`; bindings + runtime globals
  //   env.d.ts                  — hand-written; the secrets wrangler cannot introspect
  "include": [
    "worker-configuration.d.ts",
    "env.d.ts",
    "src/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
